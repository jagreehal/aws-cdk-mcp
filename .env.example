# Copy to .env; `pnpm example:*` loads it. Nothing here is a secret: the server only needs Google
# client *ids*. The client secrets belong to the MCP clients (Claude, Inspector), not this stack.
# Credentials are not read from here: `export AWS_PROFILE=…` in your shell.

# Names the stack, and so every resource in it.
STACK_NAME=jag-aws-cdk-mcp-example
AWS_REGION=eu-west-1

# none | google | iam | apiKey. Required: a missing value must not deploy a public endpoint.
MCP_AUTH=none

# MCP_AUTH=google
# GOOGLE_CLIENT_IDS=<web-client-id>,<desktop-client-id>
# HOSTED_DOMAIN=example.com

# MCP_AUTH=iam
# IAM_CALLER_ROLE_ARN=arn:aws:iam::<account>:role/<caller-role>

# google and iam: who may do what (email → scopes).
# MCP_USERS={"you@example.com":["echo"]}

# MCP_AUTH=apiKey: hashes only, never the raw key. Generate keys with 32 random bytes or more.
# MCP_API_KEYS=[{"sha256":"<64-character SHA-256 hex digest>","clientId":"team-bot","scopes":["echo"]}]

# Select at synth time: none (default, no Autotel in the bundle) | autotel
# MCP_TRACING=none
# With MCP_TRACING=autotel:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com/v1/traces
# OTEL_SERVICE_NAME=aws-cdk-mcp-example
